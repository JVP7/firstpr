DATABASE_URL=postgresql://user:password@host:5432/postgres
GITHUB_TOKEN=
JWT_SECRET=
# Origins allowed to make state-changing requests (CSRF check). Add the Vercel URL in prod.
ALLOWED_ORIGINS=http://localhost:5173
# Proxies in front of the API that append X-Forwarded-For (Vercel rewrite + Render = 2; local = 0).
TRUSTED_PROXY_HOPS=0
# DB_SSLMODE=disable   # only for a local Postgres without TLS
# ENABLE_DOCS=1        # serve /docs (off in prod)
# GitHub OAuth app (Settings > Developer settings > OAuth Apps). Callback: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of the frontend (OAuth redirects go back here)
APP_URL=http://localhost:5173
